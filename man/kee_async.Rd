head(d$x, 3)

fit <- kee_async(y ~ x,
  data_y = d$y, data_x = d$x,
  id = id, time = time, h = 0.25
)
summary(fit)
confint(fit)

# Half kernel: only covariate observations preceding the response.
kee_async(y ~ x,
  data_y = d$y, data_x = d$x,
  id = id, time = time, h = 0.25, one_sided = TRUE
)
}
